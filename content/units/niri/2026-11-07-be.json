    { "img": "are-field", "wide": true, "field": "are", "title": "הנכדים you, we, they קיבלו את שדה ARE", "text": ["you, we, they תמיד מסתובבים ביחד עם אנשים, לכן קיבלו ביחד את שדה ARE!", "you = אתם / אתן · we = אנחנו · they = הם / הן", "יוצא מן הכלל: you הוא גם לאחד בלבד (אתה / את), ועדיין הולך לשדה ARE."], "say": "you are. we are. they are", "big": "you are · we are · they are" },
    { "kids": "fields", "title": "מי קיבל איזה שדה?", "text": ["AM: I, הנכד המפונק שאוהב שקט, לבד.", "IS: he, she, it, אי-שי-ת, אוהבים התייחסות אישית.", "ARE: you, we, they, תמיד ביחד עם אנשים."] },
